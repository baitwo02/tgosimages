diff --git a/src/freertos_aarch64_guest/boot.S b/src/freertos_aarch64_guest/boot.S
index b5eb287..a24e825 100644
--- a/src/freertos_aarch64_guest/boot.S
+++ b/src/freertos_aarch64_guest/boot.S
@@ -2,9 +2,37 @@
     .globl _boot
     .type _boot, %function
 
+    .type freertos_enter_el1, %function
+
+freertos_enter_el1:
+    mrs x1, CurrentEL
+    cmp x1, #0x8
+    b.ne 1f
+
+    mrs x1, hcr_el2
+    orr x1, x1, #(1 << 31)
+    msr hcr_el2, x1
+    isb
+
+    ldr x0, =__boot_stack_top
+    msr sp_el1, x0
+
+    mov x0, #0x3c5
+    msr spsr_el2, x0
+    adr x0, 2f
+    msr elr_el2, x0
+    eret
+
+2:
+    ret
+
+1:
+    ret
+
 _boot:
     ldr x20, =0x2800d000
     mov x19, x0
+    bl freertos_enter_el1
     strb w21, [x20]
     ldr x0, =_vector_table
     msr VBAR_EL1, x0
diff --git a/src/freertos_aarch64_guest/fdt.c b/src/freertos_aarch64_guest/fdt.c
index 446151f..394ff8a 100644
--- a/src/freertos_aarch64_guest/fdt.c
+++ b/src/freertos_aarch64_guest/fdt.c
@@ -26,6 +26,30 @@ struct fdt_header {
 
 static const void *boot_fdt_ptr;
 
+static bool fdt_pointer_looks_valid(const void *fdt)
+{
+	uintptr_t addr = (uintptr_t)fdt;
+
+	if (addr == 0U) {
+		return false;
+	}
+
+	/*
+	 * U-Boot `go` passes argc in x0 on AArch64 instead of a DTB pointer.
+	 * Reject tiny/alignment-broken values here so we don't fault trying to
+	 * read a header from addresses like 0x1.
+	 */
+	if (addr < 0x10000U) {
+		return false;
+	}
+
+	if ((addr & 0x3U) != 0U) {
+		return false;
+	}
+
+	return true;
+}
+
 static uint32_t fdt32_to_cpu(uint32_t value)
 {
 	return __builtin_bswap32(value);
@@ -84,7 +108,7 @@ bool freertos_fdt_probe(struct fdt_resource_info *info)
 	bool in_aliases = false;
 	bool in_chosen = false;
 
-	if (hdr == NULL) {
+	if (!fdt_pointer_looks_valid(hdr)) {
 		return false;
 	}
 
